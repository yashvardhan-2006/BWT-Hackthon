# Server environment variables
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to Git.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use a dedicated database user with least-privilege access.
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/certiverify?retryWrites=true&w=majority
# Separate test database — MUST use a different database from MONGO_URI.
# The database name must start with "test_" or end with "_test" (e.g. certiverify_test).
TEST_MONGO_URI=mongodb://127.0.0.1:27017/certiverify_test

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d
# Cookie max-age in days
JWT_COOKIE_EXPIRES_IN=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
CLIENT_URL=http://localhost:5173

# ── Email (nodemailer) ────────────────────────────────────────────────────────
# Leave blank to disable email sending (password-reset links logged to console in dev)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=CertiVerify <noreply@example.com>

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
